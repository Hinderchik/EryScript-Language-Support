using Keyneed
using UnityEngine
using EryScriptUtils
using EryScript
using System

var tickSeconds = 0.5
var healAmount = 25
var staminaThreshold = 50
var staminaTarget = 100
var diagTicks = 6
var playersKey = "InfiniteStamina_Players"
var refillKey = "InfiniteStamina_Refills"
var diagKey = "InfiniteStamina_Diag"

method OnModLoadedCallback(script, mod)
    call GlobalVars.Set(playersKey, null)
    call GlobalVars.Set(refillKey, 0)
    call GlobalVars.Set(diagKey, 0)
    call Debug.Log("[InfiniteStamina] loop started")
    call MyAsync.WaitForSeconds(tickSeconds, "StaminaTick")
    call MyAsync.WaitForSeconds(1.0, "TrackLocal")
    call MyAsync.WaitForSeconds(5.0, "TrackLocal")
mend

method TrackLocal()
    var connId = call MyNetwork.LocalPlayer
    if connId == 0
        return null
    end
    call TrackPlayer(connId)
mend

method OnPlayerConnectedServerCallback(connId)
    call TrackPlayer(connId)
mend

method OnPlayerCreatedCallback(view, player)
    var model = call NetworkUserList.getModelFromPlayer(call view.Owner)
    if model != null
        call RefillPlayer(model)
    end
mend

method OnPlayerRespawnedServerCallback(view, life)
    call RefillLife(life)
mend

method OnPlayerDisconnectedServerCallback(connId)
    var players = call GlobalVars.Get(playersKey)
    if players == null
        return null
    end
    for i = 0 to call players.Count() - 1
        if call players.Get(i) == connId
            call players.RemoveAt(i)
            call Debug.Log("[InfiniteStamina] stopped tracking player " + connId)
            return null
        end
    end
mend

method OnChatMessageServerCallback(text, type, connId)
    if call text == "/stamina"
        call ReportStamina()
        return false
    end
    if call text == "/probe"
        call RunProbes()
        return false
    end
    return true
mend

method ReportStamina()
    var players = call GlobalVars.Get(playersKey)
    var count = 0
    var current = "n/a"
    if players != null
        count = call players.Count()
        if count > 0
            var view = call NetworkUserList.getModelFromPlayer(call players.Get(0))
            if view != null
                var life = call view.lifeLocal
                if life == null
                    life = call view.life
                end
                if life != null
                    current = life.stamina
                end
            end
        end
    end
    var refills = call GlobalVars.Get(refillKey)
    call NetworkChat.sendAlert("[InfiniteStamina] players: " + count + ", refills: " + refills + ", stamina: " + current)
mend

method RunProbes()
    call NetworkChat.sendAlert("[Probe] started, watch Player.log")
    call MyAsync.WaitForSeconds(0.3, "ProbeStamina")
    call MyAsync.WaitForSeconds(0.9, "ProbeReal")
    call MyAsync.WaitForSeconds(1.5, "ProbeExhaustMinus")
    call MyAsync.WaitForSeconds(2.1, "ProbeExhaustPlus")
    call MyAsync.WaitForSeconds(2.7, "ProbeEnergy")
    call MyAsync.WaitForSeconds(3.3, "ProbeVitality")
    call MyAsync.WaitForSeconds(4.2, "ProbeReport")
mend

method GetFirstLife()
    var players = call GlobalVars.Get(playersKey)
    if players == null
        return null
    end
    if call players.Count() == 0
        return null
    end
    var view = call NetworkUserList.getModelFromPlayer(call players.Get(0))
    if view == null
        return null
    end
    return call view.lifeLocal
mend

method ProbeStamina()
    var life = call GetFirstLife()
    if life == null
        call Debug.Log("[Probe] stamina: no life")
        return null
    end
    call Debug.Log("[Probe] stamina before=" + life.stamina)
    life.stamina = 100
    call Debug.Log("[Probe] stamina after set 100 -> " + life.stamina)
mend

method ProbeReal()
    var life = call GetFirstLife()
    if life == null
        call Debug.Log("[Probe] real: no life")
        return null
    end
    life.realStamina = 100
    call Debug.Log("[Probe] realStamina set 100 -> stamina " + life.stamina)
mend

method ProbeExhaustMinus()
    var life = call GetFirstLife()
    if life == null
        call Debug.Log("[Probe] exhaust-: no life")
        return null
    end
    call Debug.Log("[Probe] exhaust-: before=" + life.stamina)
    call life.exhaust(-100)
    call Debug.Log("[Probe] exhaust(-100) -> " + life.stamina)
mend

method ProbeExhaustPlus()
    var life = call GetFirstLife()
    if life == null
        call Debug.Log("[Probe] exhaust+: no life")
        return null
    end
    call Debug.Log("[Probe] exhaust+: before=" + life.stamina)
    call life.exhaust(100)
    call Debug.Log("[Probe] exhaust(100) -> " + life.stamina)
mend

method ProbeEnergy()
    var life = call GetFirstLife()
    if life == null
        call Debug.Log("[Probe] energy: no life")
        return null
    end
    life.energyBuffer = 100
    call Debug.Log("[Probe] energyBuffer set 100 -> stamina " + life.stamina)
mend

method ProbeVitality()
    var life = call GetFirstLife()
    if life == null
        call Debug.Log("[Probe] vitality: no life")
        return null
    end
    var serial = call life.saveAllVitality()
    call Debug.Log("[Probe] vitality serial=" + serial + " stamina=" + life.stamina)
    call life.loadAllVitality(serial)
    call Debug.Log("[Probe] vitality after load -> " + life.stamina)
mend

method ProbeReport()
    var life = call GetFirstLife()
    if life == null
        call Debug.Log("[Probe] report: no life")
        return null
    end
    call Debug.Log("[Probe] final stamina=" + life.stamina + " health=" + life.health)
mend

method TrackPlayer(connId)
    if connId == null or connId == 0
        return null
    end
    var players = call GlobalVars.Get(playersKey)
    if players == null
        players = new ObjectArrayWrapper()
        call GlobalVars.Set(playersKey, players)
    end
    for i = 0 to call players.Count() - 1
        if call players.Get(i) == connId
            return null
        end
    end
    call players.Add(connId)
    call Debug.Log("[InfiniteStamina] tracking player " + connId)
mend

method StaminaTick()
    call MyAsync.WaitForSeconds(tickSeconds, "StaminaTick")
    call RefillAll()
    call DiagTick()
    return null
mend

method RefillAll()
    var players = call GlobalVars.Get(playersKey)
    if players == null
        return null
    end
    for i = 0 to call players.Count() - 1
        var view = call NetworkUserList.getModelFromPlayer(call players.Get(i))
        if view != null
            call RefillPlayer(view)
        end
    end
mend

method RefillPlayer(view)
    if view == null
        return null
    end
    var life = call view.lifeLocal
    if life == null
        life = call view.life
    end
    call RefillLife(life)
mend

method RefillLife(life)
    if life == null
        return null
    end
    if life.health > 0
        call life.damage(-healAmount, "heal")
    end
    var current = life.stamina
    if current < staminaThreshold
        life.stamina = staminaTarget
        call Debug.Log("[InfiniteStamina] stamina " + current + " -> " + life.stamina)
        call CountRefill()
    end
mend

method CountRefill()
    var count = call GlobalVars.Get(refillKey)
    if count == null
        count = 0
    end
    call GlobalVars.Set(refillKey, count + 1)
mend

method DiagTick()
    var n = call GlobalVars.Get(diagKey)
    if n == null
        n = 0
    end
    n = n + 1
    if n < diagTicks
        call GlobalVars.Set(diagKey, n)
        return null
    end
    call GlobalVars.Set(diagKey, 0)
    var players = call GlobalVars.Get(playersKey)
    var count = 0
    var info = "no-life"
    if players != null
        count = call players.Count()
        if count > 0
            var view = call NetworkUserList.getModelFromPlayer(call players.Get(0))
            if view != null
                var life = call view.lifeLocal
                if life != null
                    info = "sta=" + life.stamina + " hp=" + life.health
                else
                    info = "lifeLocal=null"
                end
            else
                info = "model=null"
            end
        end
    end
    call Debug.Log("[InfiniteStamina] players=" + count + " refills=" + call GlobalVars.Get(refillKey) + " " + info)
mend
