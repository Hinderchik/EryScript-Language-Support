using Keyneed
using UnityEngine
using EryScriptUtils
using EryScript
using System

var tickSeconds = 1.0
var healPerTick = 25
var staminaPerTick = 100
var staminaThreshold = 50
var playersKey = "InfiniteStamina_Players"
var staminaModeKey = "InfiniteStamina_Mode"
var loopKey = "InfiniteStamina_Loop"

method OnModLoadedCallback(script, mod)
    call Debug.Log("[InfiniteStamina] mod loaded")
    call EnsureLoop()
mend

method EnsureLoop()
    try
        if call GlobalVars.Get(loopKey) == 1
            return null
        end
        call GlobalVars.Set(loopKey, 1)
        call Debug.Log("[InfiniteStamina] loop started")
        call MyAsync.WaitForSeconds(tickSeconds, "StaminaTick")
        return null
    catch
        return null
    end
mend

method OnPlayerConnectedServerCallback(connId)
    call TrackPlayer(connId)
mend

method OnPlayerCreatedCallback(view, player)
    call TrackPlayer(call view.Owner)
mend

method OnPlayerRespawnedServerCallback(view, life)
    call TrackPlayer(call view.Owner)
    call EnsureLoop()
    call RefillLife(life)
mend

method OnPlayerDisconnectedServerCallback(connId)
    var players = call GlobalVars.Get(playersKey)
    if players == null
        return null
    end
    for i = 0 to call players.Count() - 1
        if call players.Get(i) == connId
            call players.RemoveAt(i)
            call Debug.Log("[InfiniteStamina] stopped tracking player " + connId)
            return null
        end
    end
mend

method OnChatMessageServerCallback(text, type, connId)
    if call text == "/stamina"
        call ReportStamina()
        return false
    end
    return true
mend

method ReportStamina()
    var players = call GlobalVars.Get(playersKey)
    var count = 0
    var mode = call GlobalVars.Get(staminaModeKey)
    var current = "n/a"
    if players != null
        count = call players.Count()
        if count > 0
            var view = call NetworkUserList.getModelFromPlayer(call players.Get(0))
            if view != null
                try
                    var life = call view.lifeLocal
                    if life != null
                        current = life.stamina
                    end
                catch
                    current = "n/a"
                end
            end
        end
    end
    if mode == null
        mode = "detecting"
    end
    call NetworkChat.sendAlert("[InfiniteStamina] players: " + count + ", mode: " + mode + ", stamina: " + current)
mend

method TrackPlayer(connId)
    if connId == null or connId == 0
        return null
    end
    var players = call GlobalVars.Get(playersKey)
    if players == null
        players = new ObjectArrayWrapper()
        call GlobalVars.Set(playersKey, players)
    end
    for i = 0 to call players.Count() - 1
        if call players.Get(i) == connId
            call EnsureLoop()
            return null
        end
    end
    call players.Add(connId)
    call Debug.Log("[InfiniteStamina] tracking player " + connId)
    call EnsureLoop()
mend

method StaminaTick()
    var players = call GlobalVars.Get(playersKey)
    if players != null
        for i = 0 to call players.Count() - 1
            var view = call NetworkUserList.getModelFromPlayer(call players.Get(i))
            if view != null
                call RefillPlayer(view)
            end
        end
    end
    call MyAsync.WaitForSeconds(tickSeconds, "StaminaTick")
mend

method RefillPlayer(view)
    if view == null
        return null
    end
    try
        var life = call view.lifeLocal
        if life == null
            return null
        end
        call RefillLife(life)
        return null
    catch
        return null
    end
mend

method RefillLife(life)
    if life == null
        return null
    end
    var mode = call DetectStaminaMode(life)
    try
        if life.health > 0
            call life.damage(-healPerTick, "heal")
        end
    catch
        return null
    end
    call EnsureStamina(life, mode)
mend

method DetectStaminaMode(life)
    var mode = call GlobalVars.Get(staminaModeKey)
    if mode != null
        return mode
    end
    try
        call life.SetStamina()
        call GlobalVars.Set(staminaModeKey, "method")
        call Debug.Log("[InfiniteStamina] stamina restored by life.SetStamina()")
        return "method"
    catch
        call Debug.Log("[InfiniteStamina] life.SetStamina() is not available")
    end
    try
        life.stamina = staminaPerTick
        call GlobalVars.Set(staminaModeKey, "field")
        call Debug.Log("[InfiniteStamina] stamina restored by life.stamina field")
        return "field"
    catch
        call Debug.Log("[InfiniteStamina] life.stamina field is not available, healing only")
    end
    call GlobalVars.Set(staminaModeKey, "none")
    return "none"
mend

method EnsureStamina(life, mode)
    if mode == "none"
        return null
    end
    try
        var current = life.stamina
        if current == null
            call RefillStamina(life, mode)
            return null
        end
        if current < staminaThreshold
            call RefillStamina(life, mode)
            return null
        end
        return null
    catch
        call RefillStamina(life, mode)
        return null
    end
mend

method RefillStamina(life, mode)
    try
        if mode == "method"
            call life.SetStamina()
            return null
        end
        if mode == "field"
            life.stamina = staminaPerTick
            return null
        end
        return null
    catch
        return null
    end
mend
